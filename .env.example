# OpenAI / Azure OpenAI
OPENAI_ENDPOINT=
OPENAI_API_KEY=
OPENAI_API_VERSION=2024-10-21

# Task-specific LLM deployments/models
ANALYSIS_MODEL=gpt-4.1-mini
URGENCY_MODEL=gpt-4.1
RESPONSE_MODEL=gpt-4.1

# Optional global fallbacks
DEFAULT_MODEL=gpt-4.1-mini
ADVANCED_MODEL=gpt-4.1

# Sentiment model for transformers pipeline
SENTIMENT_MODEL=siebert/sentiment-roberta-large-english

URGENCY_THRESHOLD=0.7

# Demo web app settings
DEMO_MODE=true
DEMO_POSITIVE_DELAY_SECONDS=45
DEMO_HOST=127.0.0.1
DEMO_PORT=8080
